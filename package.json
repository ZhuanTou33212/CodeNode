{
  "name": "codenode-desktop-next",
  "version": "0.13.0",
  "private": true,
  "license": "MIT",
  "author": "yimi528 <148250049+yimi528@users.noreply.github.com>",
  "description": "CodeNode Agent 工作台：画布、工具循环与本地 Agentic RAG",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/run-electron.cjs .",
    "build": "tsc --noEmit && vite build",
    "test:rag": "node scripts/rag-test.cjs && node scripts/rag-grounding-test.cjs",
    "test:scalar": "node scripts/scalar-vector-test.cjs",
    "test:vector-store": "node scripts/vector-store-test.cjs",
    "test:undo": "node scripts/graph-undo-test.cjs",
    "test:cache": "node scripts/cache-consistency-test.cjs",
    "test:session": "node scripts/session-canvas-test.cjs",
    "test:model": "node scripts/workbench-model-test.cjs",
    "test:arrange": "node scripts/arrange-test.cjs",
    "test:container": "node scripts/container-model-test.cjs",
    "test:scope-frame": "node scripts/scope-frame-test.cjs",
    "test:bg": "node scripts/background-job-test.cjs",
    "test:smoke": "node scripts/smoke-runner.cjs",
    "test:rag-ui": "node scripts/run-electron.cjs scripts/rag-ui-test.cjs",
    "test:shell-output": "node scripts/shell-output-test.cjs",
    "test:subagent": "node scripts/subagent-test.cjs",
    "test:agent-cache": "node scripts/agent-cache-invalidation-test.cjs",
    "test:ipc": "node scripts/ipc-registry-test.cjs",
    "test:agent-reliability": "node scripts/agent-reliability-test.cjs",
    "test:security": "node scripts/model-store-security-test.cjs && node scripts/public-http-security-test.cjs && node scripts/path-boundary-test.cjs",
    "test:run-store": "node scripts/run-store-reliability-test.cjs",
    "test:bridge": "node scripts/bridge-cancellation-test.cjs",
    "test:agent-boundary": "node scripts/agent-boundary-test.cjs",
    "test:request-budget": "node scripts/request-budget-test.cjs",
    "test:atomic-file": "node scripts/atomic-file-test.cjs",
    "test:runtime-gate": "node scripts/runtime-gate.cjs",
    "test:sandbox": "node scripts/sandbox-test.cjs",
    "test:resume": "node scripts/agent-resume-test.cjs",
    "test:cost": "node scripts/cost-monitor-test.cjs",
    "test:production-gate": "node scripts/production-gate.cjs",
    "test:eval": "node scripts/agent-eval.cjs",
    "test:eval:model": "node scripts/agent-eval.cjs --mode=model --require-model",
    "test:eval:list": "node scripts/agent-eval.cjs --list",
    "test:provider-smoke": "node scripts/provider-smoke.cjs",
    "test:vector": "node scripts/vector-ui-test.cjs",
    "test": "node scripts/run-all-tests.cjs",
    "test:display": "node scripts/run-all-tests.cjs --group display",
    "test:list": "node scripts/run-all-tests.cjs --list",
    "check:js": "tsc -p tsconfig.checkjs.json",
    "verify": "npm run build && npm run check:js && npm test",
    "start": "node scripts/run-electron.cjs .",
    "start:prod": "npm run build && node scripts/run-electron.cjs .",
    "launcher": "node scripts/make-launcher.cjs",
    "dist:win": "node scripts/build-release.cjs win && node scripts/make-launcher.cjs",
    "dist:mac": "node scripts/build-release.cjs mac",
    "dist:linux": "node scripts/build-release.cjs linux",
    "dist": "node scripts/build-release.cjs win && node scripts/make-launcher.cjs",
    "release:sign": "node scripts/release-sign.cjs",
    "release:hash": "node scripts/release-sign.cjs --no-sign",
    "icons:build": "electron scripts/build-icon-v3.cjs",
    "postbuild": "npm run icons:build"
  },
  "build": {
    "appId": "com.codenode.desktop",
    "productName": "CodeNode",
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "cache": ".cache/electron",
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon-512.png"
    },
    "fileAssociations": [
      {
        "ext": "cnode",
        "name": "CodeNode Workflow",
        "description": "CodeNode 工作流工程",
        "role": "Editor"
      }
    ],
    "portable": {
      "artifactName": "CodeNode-${version}.exe"
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
