  "build": {
    "appId": "com.codenode.desktop",
    "productName": "CodeNode",
    "directories": {
      "output": "release"
    },
    "electronDownload": {
      "cache": ".cache/electron",
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "assets/branding/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "electron/tools/fsWorker.cjs",
      "electron/tools/fsCore.cjs",
      "electron/tools/impl/pdfText.cjs",
      "electron/tools/impl/documentText.cjs",
      "node_modules/sqlite-vec-*/**/*",
      "electron/rag/**/*",
      "electron/embedder/**/*",
      "electron/vectorStore/index.cjs",
      "electron/vectorStore/memory.cjs",
      "electron/tools/toolFiles.cjs",
      "node_modules/typescript/**/*",
      "node_modules/@typescript/typescript6/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon-512.png"
    },
    "fileAssociations": [
      {
        "ext": "cnode",
        "name": "CodeNode Workflow",
        "description": "CodeNode 工作流工程",
        "role": "Editor"
      }
    ],
    "portable": {
      "artifactName": "CodeNode-${version}.exe"
    }
  },
