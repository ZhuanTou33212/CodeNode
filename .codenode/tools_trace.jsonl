{"ts":"2026-08-24T17:30:36.337Z","kind":"tool","iter":2,"name":"workbench_edit","repeated":false,"malformed":false,"ok":true,"elapsedMs":1,"args":"{\"operations\": [{\"action\": \"create\", \"name\": \"代码审查子代理 · 设计蓝图\", \"type\": \"start\", \"prompt\": \"代码审查/质量检查子代理设计蓝图起点。目标：产出一份可落地实现的子代理规格说明。\", \"x\": 0, \"y\": 0}, {\"action\": \"create\", \"name\": \"① 职责边界 Scope\", \"type\": \"scope\", \"prompt\": \"审什么：代码规范、安全漏洞（硬编码密钥/注入）、空指针风险、方法复杂度、TODO遗留。范围：单文件或一次变更（diff）。深度：报告问题并附修复建议，不止于指出。\", \"x\": 240, \"y\": 0}, {\"action\": \"create\", \"name\": \"② 输入输出 Interface\", \"type\": \"scope\", \"prompt\": \"输入：代码文本 / 文件路径 / 规则配置文件。输出：结构化审查报告（Markdown 或 JSON）：问题清单 + 严重级别 + 精确行号 + 修复建议；无问题时明确声明『未发现违规』。\", \"x\": 480, \"y\": 0}, {\"action\": \"create\", \"name\": \"③ 审查规则集 Rules\", \"type\": \"file\", \"prompt\": \"规则集清单（rules.md）：每条规则 = 触发条件 + 严重级别 + 修复建议。示例：硬编码密钥/密码(高)、空指针解引用(高)、过长方法>200行(中)、TODO/FIXME 遗留(低)。规则可配置、可增删。\", \"x\": 720, \"y\": 0}, {\"action\": \"create\", \"name\": \"扫描定位\", \"type\": \"task\", \"prompt\": \"识别审查目标（文件路径/变更集/语言），确认范围与依赖关系。产出：目标清单。\", \"x\": 960, \"y\": 180}, {\"action\": \"create\", \"name\": \"提取结构\", \"type\": \"task\", \"prompt\": \"用 read_file/analyze 提取 import/类/函数/变量结构，为逐规则检查提供上下文。产出：结构摘要。\", \"x\": 1120, \"y\": 180}, {\"action\": \"create\", \"name\": \"逐规则检查\", \"type\": \"task\", \"prompt\": \"按规则表逐条执行 code_review 检查；每个问题记录文件、行号、触发证据。产出：问题明细。\", \"x\": 1280, \"y\": 180}, {\"action\": \"create\", \"name\": \"汇总报告\", \"type\": \"task\", \"prompt\": \"汇总输出结构化审查报告：问题清单 + 严重级别 + 行号 + 修复建议；无问题时明确声明。产出：最终报告。\", \"x\": 1440, \"y\": 180}, {\"action\": \"create\", \"name\": \"⑤ 工具集 Tools\", \"type\": \"tool\", \"prompt\": \"只授予只读工具：read_file、search_files、code_review。不授予写文件/执行危险命令权限——保证子代理『只读、只报、不改』。\", \"x\": 1200, \"y\": 0}, {\"action\": \"create\", \"name\": \"⑥ 质量与退出机制\", \"type\": \"scope\", \"prompt\": \"质量：报告必须可溯源（含行号/证据），禁止编造；误报率控制。退出：无法判断时（如扫描版PDF、超大文件、权限不足）明确说明『无法处理』并给出原因，不硬编。\", \"x\": 1440, \"y\": 0}, {\"action\": \"create\", \"name\": \"蓝图完成\", \"type\": \"end\", \"prompt\": \"蓝图产出完成：子代理规格（职责/接口/规则/工作流/工具/质量）齐全，可进入实现或原型验证阶段。\", \"x\": 1680, \"y\": 0}]}"}
