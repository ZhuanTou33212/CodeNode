{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenode.local/schema/agent-canary-output.json",
  "title": "CodeNode Agent canary output",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "language", "nodeName", "summary", "steps"],
  "properties": {
    "requestId": { "type": "string", "pattern": "^live-canary-[0-9]+$" },
    "language": { "type": "string", "enum": ["java", "powershell", "go"] },
    "nodeName": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
