{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenode.local/schema/workflow-result.json",
  "title": "CodeNode workflow result",
  "type": "object",
  "required": ["schemaVersion", "requestId", "status"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "requestId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["queued", "processing", "succeeded", "failed", "cancelled"] },
    "action": { "type": "string", "enum": ["build-node", "build-program"] },
    "language": { "type": "string", "enum": ["java", "powershell", "go"] },
    "summary": { "type": "string" },
    "error": { "type": "string" },
    "requiresConfirmation": { "type": "boolean" },
    "output": {
      "type": "object",
      "properties": {
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "enum": ["source", "binary", "metadata", "diagnostic"] },
              "language": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "scope": { "type": "string", "enum": ["node", "source", "project"] },
          "nodeId": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 },
          "code": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "nodeResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "status"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pending", "succeeded", "failed", "skipped"] },
          "code": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "processedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
