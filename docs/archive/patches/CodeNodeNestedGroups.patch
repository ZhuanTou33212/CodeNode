+        x += metrics.stringWidth(root) + 36;
+        List<WorkflowModel.Node> path = this.groupPath();
+        for (int i = 0; i < path.size(); i++) {
+            int width = metrics.stringWidth(path.get(i).name) + 28;
+            if (point.x >= x && point.x < x + width) return i + 2;
+            x += width + 8;
+        }
+        return -1;
+    }

