{
  "// 说明": "对 Electron 主进程 / 工具层 / 脚本做静态检查（这些文件是 .cjs，不受 src/ 的 tsc 覆盖）",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.cjs", "scripts/**/*.cjs"]
}
