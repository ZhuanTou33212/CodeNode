# CodeNode Agent 配置（本地，api_key 不入库不提交）
api_base=https://api.deepseek.com
api_key=
model=deepseek-v4-flash
# 单次回答的输出上限（token）。**思考链的 token 也算在这笔额度里**：真实实测
# （reasoning_effort=medium）一份 4000 字文档会用掉 5k~8k，其中一半是思考 ——
# 8k 档位上「回答写一半就被截断」是掷硬币；供应商侧 32768 / 65536 都接受。
max_tokens=32768
# 推理强度：low / medium / high
# reasoning_effort=high
# 瞬时网络错误重试（408/425/429/5xx 与连接失败），不会重试用户取消/超时
# agent.request_max_attempts=3
# agent.retry_base_ms=400
# agent.retry_max_ms=5000
# ── 单轮时长与流式中断恢复（回答「聊一半断掉」的两类根因）───────────────
# agent.turn_timeout_ms=600000          # 单轮模型请求的总时长上限（含重发），出厂 600s（旧行为写死 180s）
# agent.stream_idle_timeout_ms=120000   # 停滞判定：连续这么久没有任何分片才认为卡死（有数据就重置）
# agent.stream_max_attempts=2           # 流中途断线/停滞 → 丢弃半截、整轮重发的次数（0=旧行为：半截+报错）
# agent.truncation_nudges=4             # 回答触到 max_tokens 时最多补问几次（让它从断点接着写）
# 单进程并发与单轮累计 token 上限
# agent.max_concurrent_runs=2
# agent.max_total_tokens=250000
# 灵魂文档路径（相对工程根或绝对路径）
soul_file=config/soul.md

# ---------- Agent 工具配置 ----------
# 总开关：false 关闭全部工具（仅纯对话）
# tools.enabled=true
# 白名单：非空时只允许列出的工具（逗号分隔）；留空=全部允许
# 可用工具：get_workbench_model / create_nodes / workbench_edit / workbench_connect /
#           scan_project / analyze_project / project_info / read_file / write_file / edit_file /
#           find_files / search_files / list_directory / execute_shell / code_review / ask_user /
#           fetch_url / save_project / bulk_edit / ui_control / write_analysis_md / retrieve_context
# tools.allowed=read_file,write_file,edit_file,find_files,search_files,list_directory,get_workbench_model,create_nodes,workbench_edit,workbench_connect,ask_user,execute_shell,fetch_url,code_review,scan_project,analyze_project,project_info,save_project,bulk_edit,ui_control,write_analysis_md,retrieve_context
# 黑名单：禁用某些工具（逗号分隔）
# tools.deny=execute_shell,bulk_edit

# ---------- Agentic RAG（本地、按需、增量） ----------
# Agent 通过 retrieve_context 自主检索项目源码/文档；不上传索引。
# rag.enabled=true
# rag.max_files=5000
# rag.max_file_bytes=524288
# rag.chunk_lines=72
# rag.chunk_overlap=12
# rag.top_k=6
# rag.max_context_chars=12000
# rag.max_queries=5
# rag.min_coverage=0.20
# 可选收录/排除 glob（逗号分隔）；敏感文件无论配置如何都不会收录
# rag.include=src/**,docs/**,README*
# rag.exclude=**/*.generated.*,fixtures/**

# ---------- 向量层（可插拔嵌入器） ----------
# provider：local（默认，纯本地确定性 n-gram 哈希向量，无网络）/
#           openai（OpenAI 兼容 /embeddings，需 embed_base+embed_key+embed_model）/
#           ollama（本地 Ollama，需 embed_base+embed_model）/
#           none（关闭向量层，只用 BM25）
# rag.embed_provider=local
# rag.embed_dim=4096            # local 向量维度
# rag.embed_model=              # openai 用 text-embedding-3-small；ollama 用 nomic-embed-text
# rag.embed_base=               # openai 默认 https://api.openai.com/v1；ollama 默认 http://localhost:11434
# rag.embed_key=                # openai 需要
# rag.embed_dimensions=         # OpenAI v3 模型降维（如 1536 → 1024）；ollama 走模型原生维度，留空
# 生产档（百万级 / 每条 1024 维）：二选一
#   openai：embed_provider=openai + embed_model=text-embedding-3-small + embed_dim=1024 + embed_dimensions=1024
#   ollama：embed_provider=ollama + embed_model=bge-m3 + embed_dim=1024（bge-m3 原生 1024 维，中文友好）
# rag.embed_top_k=40            # 向量层只对 BM25 预筛的 Top-K 做语义余弦，保证效率
# rag.vector_weight=0.35        # 向量分融合权重（0~1）
# retrieve_context 支持 mode=auto/file/vector/hybrid/scalar（scalar 走本地标量精确查询）

# ---------- 向量后端（chunk 向量存放与检索方式） ----------
# memory（默认）：进程内记忆化 + 仅对 BM25 预筛 Top-K 打分；零外部服务、零网络。
# milvus：外部 Milvus 服务，chunk 向量写入 collection，检索走全库 ANN（不再受 BM25 预筛限制）。
#   注意：milvus 是本项目唯一会把 chunk 向量落到外部服务的形态，默认关闭；
#   需先在项目根执行 `npm i @zilliz/milvus2-sdk-node`（SDK 刻意不进默认依赖，保持零依赖与体积）；
#   服务端自建参考 milvus standalone（docker compose）或 Zilliz Cloud。
# rag.vector_store=memory
# rag.milvus_address=http://127.0.0.1:19530
# rag.milvus_collection=          # 留空则按工程根自动命名 codenode_rag_<目录名>_<hash8>
# rag.milvus_token=               # Zilliz Cloud / 带鉴权的服务端
# rag.milvus_username=
# rag.milvus_password=
# rag.milvus_consistency=strong   # strong（默认，刚写入/删除立即可见）| bounded | eventually | session | default
#   服务端不支持该级别时（部分云托管只支持 bounded）自动退回服务端默认，并在 stats.vector.store.consistencyFallback 记录原因
# 索引与检索参数（默认即「百万级 / 1024 维 / HNSW」生产档）
# rag.milvus_index_type=HNSW      # HNSW（默认）| AUTOINDEX | IVF_FLAT | DISKANN ...（既有 collection 不会重建索引）
# rag.milvus_metric_type=COSINE   # COSINE（默认）| IP | L2
# rag.milvus_index_m=16           # HNSW 建索引 M（每层邻居数，越大越准也越吃内存）
# rag.milvus_index_ef_construction=200   # HNSW 建图深度，越大越准、建索引越慢
# rag.milvus_search_ef=64         # HNSW 检索候选面宽 ef（须 ≥ 召回条数；越大越准越慢）
# rag.milvus_batch_size=128       # 单次嵌入+写入批大小（百万级写入靠它控内存与请求数）
# rag.milvus_flush_every_batches=4   # 每 N 批 flush 一次（逐批 flushSync 在百万级下代价过高），收尾必刷
# 分布式 / 读写分离：属服务端拓扑（多个 querynode/proxy、WAL），客户端只需把 milvus_address 指向
#   负载均衡/proxy 入口；一致性级别是延迟与新鲜度的取舍——分布式生产更常用于 bounded，
#   本地单机建议保持 strong（见 docs/agentic-rag-scalar-vector.md 2.2.1.1）
# 说明：milvus 后端下 rag.embed_top_k 作为全库召回上限；embed_provider=local 的哈希向量
# 语义能力有限，接 Milvus 建议同时切 openai/ollama 真嵌入。写入失败/服务不可用会降级为
# 纯 BM25 并在检索结果中标注「向量后端降级」，不会中断检索。

# ---------- 本地标量（画布精准数据，不入云） ----------
# 画布节点等精准数据（prompt/goal/members/filePath）在工具执行时写入工程 .codenode/scalars.json，
# 不随上下文返回云端；Agent 需要时用 query_scalars key=node:<id> 或 retrieve_context mode=scalar 读取。
# scalars.enabled=true

# ---------- 工具结果子代理压缩 ----------
# 工具返回的原始结果超过阈值时，会经一次独立 LLM 调用（子代理，不共享主对话）压缩成关键信息再回上下文。
# agent.compression.enabled=true
# agent.compression.threshold_chars=2400   # 低于此长度的结果直接透传
# agent.compression.budget_chars=1500      # 压缩摘要目标长度
# agent.compression.max_calls=8            # 单轮最多压缩调用次数
# agent.compression.exclude=               # 追加不压缩的工具（默认已有 retrieve_context,query_scalars,ask_user）
# 工具支持 query + queries 多查询融合；低可信度结果会要求 Agent 继续检索
