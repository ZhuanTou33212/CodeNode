# CodeNode Agent 本地配置示例
# 使用方式：复制本文件为 config/agent.properties 并填写 api_key（api_key 仅存本地，禁止提交到仓库）。
api_base=https://api.deepseek.com/v1
api_key=
model=deepseek-v4-flash
models=deepseek-v4-flash,deepseek-v4-pro
agent.permissions=ui:allow,write:confirm,execute:confirm,system:enabled
default_project_path=

# ---- harness 与工具设置（Stage6）----
# Cordis profile 名称（用于组合/诊断）
# harness.profile=default
# 额外 Cordis 插件类名（逗号分隔，要求公开无参构造器）
# harness.plugins=
# Bundle properties 文件（按声明顺序覆盖前一层）
# harness.bundles=
# Patch properties 文件（最后应用，按声明顺序覆盖）
# harness.patches=
# 组件类别（逗号分隔；空=启用全部内置组件）
# 可选：llm,prompt,tools,compactor,storage,session-events,loop,agent-loop,agents,listeners,planner,sandbox,ui,scheduler,skills
# harness.components=llm,prompt,tools,compactor,storage,session-events,loop,agent-loop,agents,listeners,planner,sandbox,ui,scheduler,skills
# 工具来源（可配置多个；builtin=内置工具，mcp=MCP server 工具）
# tools.sources=builtin,mcp
# 系统提示分段及顺序（可按需删除/重排）
# harness.prompt_sections=role,file_rules,scan_rules,knowledge_rules,project_memory,user_memory,knowledge_state,tasks,agent_info,extra
# 压缩策略：auto / llm / local / none
# harness.compactor=auto
# 会话存储：file（默认）/ memory / 第三方扩展名
# harness.storage=file
# 追加式会话事件日志：file（默认）/ memory / 第三方扩展名
# harness.session_log=file
# 监听器：trace 将执行事件写入 .codenode/agent-traces/
# harness.listeners=trace
# 规划组件每多少个工具步骤检查一次；0=关闭
# harness.plan_check_interval=3
# Agent loop 策略与默认限制（第三方可注册其他 loop policy）
# harness.loop=default
# 整轮 Agent 驱动器（第三方可注册其他 agent loop）
# harness.agent_loop=default
# 子代理服务工厂（第三方可注册其他 agents provider）
# harness.agents=default
# harness.loop.max_rounds=10
# harness.loop.max_retries=5
# harness.loop.default_timeout_seconds=60
# harness.loop.long_timeout_seconds=300
# 上下文窗口 token 上限；0=关闭按 token 自动压缩
# agent.context_length=128000
# 仅启用的工具（逗号分隔；空=全部启用）
# tools.enabled=read_file,find_files,search_files,list_directory
# 禁用的工具（逗号分隔；优先级高于 tools.enabled）
# tools.disabled=execute_shell,write_file,edit_file,fetch_url
# 追加到系统提示末尾的自定义规则（\n 换行）
# harness.extra_prompt=不要修改 config/ 目录下的任何文件。\n遇到看不懂的类型先问用户。
# read_file 默认最大行数（超过截断）
# read_file.max_lines=200
# analyze 模式结构摘要的最大分析行数
# file_analysis.max_lines=200
